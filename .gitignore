# Ignore repository-level lockfiles
# These are typically generated by package managers and should not be committed.
yarn.lock
package-lock.json
pnpm-lock.yaml
pnpm-lock.yml
packages.lock.json
Pipfile.lock
poetry.lock
composer.lock
Gemfile.lock
Cargo.lock

# Ignore transient lockfiles that appear inside node_modules
# These are created by dependency packages and should not be committed.
node_modules/**/yarn.lock
node_modules/**/package-lock.json
node_modules/**/pnpm-lock.yaml
node_modules/**/pnpm-lock.yml
node_modules/**/packages.lock.json

# Optional: uncomment to ignore entire node_modules directory
# node_modules/
